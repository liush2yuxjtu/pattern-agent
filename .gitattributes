# Generated print/CAD deliverables must retain exact bytes, including PDF xrefs
# and the official exporter's DXF line endings. Verify their geometry separately.
*.pdf binary
*.dxf binary

# Pinned upstream Three.js source is retained byte-for-byte, including its indent.
web/human-studio/vendor/three.webgpu.js whitespace=-space-before-tab

# Preserve verbatim case evidence: RFC-style CSV CRLF and raw source excerpt.
web/garment-body/product-case/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
web/garment-body/product-case/model/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
web/garment-body/product-case/reference/asos-product-excerpt.md whitespace=-blank-at-eof
web/garment-body/single-state-evals/**/*.csv whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Frozen inspector embeds binary geometry and a CSP script hash; preserve bytes.
experiments/fitted_tshirt/seam_inspector/inspector.html binary
experiments/fitted_tshirt/seam_inspector/accepted-model.glb binary
