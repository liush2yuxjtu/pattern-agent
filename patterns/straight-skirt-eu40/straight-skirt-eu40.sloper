{
  "format": "pattern",
  "version": 1,
  "units": "mm",
  "notes": "Straight skirt, Burda reference 40: body W740 H980; finished W750 H1020. Body length 600 + waistband 40. Darts are sewn markings, NOT cutouts. Main seams 10 mm; back centre 15 mm; hem 30 mm; front fold 0. Back zip 200 mm; centre-back slit 180 mm. Make a toile and true waist/hem after fitting.",
  "measurementFile": "measurements-eu40.slm",
  "identity": "454fcd08-c89f-416a-bfce-63c764560fe7",
  "nextId": 84,
  "variables": [
    {
      "id": 1,
      "name": "hip_ease",
      "formula": "40",
      "description": "Total hip ease"
    },
    {
      "id": 2,
      "name": "waist_ease",
      "formula": "10",
      "description": "Total waist ease"
    },
    {
      "id": 3,
      "name": "half_hip",
      "formula": "(@hip + {1}) / 2",
      "description": "Half the finished hip"
    },
    {
      "id": 4,
      "name": "back_hip",
      "formula": "{3} / 2 - 10",
      "description": "Back quarter width"
    },
    {
      "id": 5,
      "name": "front_hip",
      "formula": "{3} - {4}",
      "description": "Front quarter width"
    },
    {
      "id": 6,
      "name": "suppression",
      "formula": "(@hip + {1} - @waist - {2}) / 2",
      "description": "Half-skirt shaping"
    },
    {
      "id": 7,
      "name": "side_take",
      "formula": "{6} / 4",
      "description": "Waist intake at each quarter side"
    },
    {
      "id": 8,
      "name": "back_dart",
      "formula": "{6} * 0.3",
      "description": "Back dart intake"
    },
    {
      "id": 9,
      "name": "front_dart",
      "formula": "{6} * 0.2",
      "description": "Front dart intake"
    },
    {
      "id": 10,
      "name": "back_dart_length",
      "formula": "140",
      "description": "Back dart length"
    },
    {
      "id": 11,
      "name": "front_dart_length",
      "formula": "90",
      "description": "Front dart length"
    },
    {
      "id": 12,
      "name": "waistband_height",
      "formula": "40",
      "description": "Finished folded waistband height"
    },
    {
      "id": 13,
      "name": "waistband_overlap",
      "formula": "30",
      "description": "Extension for hook/bar fastening"
    },
    {
      "id": 14,
      "name": "zip_length",
      "formula": "200",
      "description": "Back zipper length"
    },
    {
      "id": 15,
      "name": "slit_height",
      "formula": "180",
      "description": "Centre-back walking slit"
    }
  ],
