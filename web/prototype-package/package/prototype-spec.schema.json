{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Imported Pattern Spec v0.1",
  "type": "object",
  "required": [
    "schema",
    "id",
    "revision",
    "representation",
    "source",
    "style",
    "parts",
    "geometry",
    "source_bindings",
    "measurements",
    "targets",
    "seam_graph",
    "construction",
    "program",
    "rule_assets",
    "capabilities",
    "preview",
    "unresolved",
    "state"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "pattern-spec/imported-v0.1"
    },
    "id": {
      "type": "string"
    },
    "revision": {
      "type": "string"
    },
    "representation": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": [
        "file",
        "sha256",
        "encoding_for_text",
        "newline",
        "declared_unit",
        "mm_per_drawing_unit",
        "scale_hypothesis"
      ],
      "additionalProperties": false,
      "properties": {
        "file": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "encoding_for_text": {
          "const": "gb18030"
        },
        "newline": {
          "const": "CRLF"
        },
        "declared_unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "mm_per_drawing_unit": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "scale_hypothesis": {
          "type": "object"
        }
      }
    },
    "style": {
      "type": "object"
    },
    "parts": {
      "type": "array"
    },
    "geometry": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^src_e[0-9]{4}$"
      },
      "additionalProperties": {
        "type": "object",
        "required": [
          "id",
          "index",
          "type",
          "layer",
          "piece_id"
        ],
        "properties": {
          "type": {
            "enum": [
              "POLYLINE",
              "LINE",
              "TEXT"
            ]
          },
          "points": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number"
              }
            }
          }
        }
      }
    },
    "source_bindings": {
      "type": "array",
      "minItems": 1
    },
    "measurements": {
      "type": "object"
    },
    "targets": {
      "type": "object"
    },
    "seam_graph": {
      "type": "object"
    },
    "construction": {
      "type": "object"
    },
    "program": {
      "type": "object"
    },
    "rule_assets": {
      "type": "array"
    },
    "capabilities": {
      "type": "object"
    },
    "preview": {
      "type": "object"
    },
    "unresolved": {
      "type": "array"
    },
    "state": {
      "type": "string"
    }
  }
}
