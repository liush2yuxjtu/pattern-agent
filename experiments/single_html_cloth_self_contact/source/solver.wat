(module
 (memory (export "memory") 64)
 ;; Metres, seconds, kg. Float64 Verlet integration and XPBD distance constraints.
 (func (export "integrate") (param $n i32) (param $p i32) (param $old i32) (param $mass i32) (param $dt f64) (param $wind f64)
  (local $i i32) (local $k i32) (local $a i32) (local $b i32) (local $x f64) (local $v f64) (local $acc f64)
  (block $done (loop $points
   (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
   (if (f64.gt (f64.load (i32.add (local.get $mass) (i32.mul (local.get $i) (i32.const 8)))) (f64.const 0))
    (then
     (local.set $k (i32.const 0))
     (loop $axes
      (local.set $a (i32.add (local.get $p) (i32.mul (i32.add (i32.mul (local.get $i) (i32.const 3)) (local.get $k)) (i32.const 8))))
      (local.set $b (i32.add (local.get $old) (i32.sub (local.get $a) (local.get $p))))
      (local.set $x (f64.load (local.get $a)))
      (local.set $v (f64.mul (f64.sub (local.get $x) (f64.load (local.get $b))) (f64.const 0.992)))
      (local.set $acc (f64.const 0))
      (if (i32.eq (local.get $k) (i32.const 1)) (then (local.set $acc (f64.const -9.81))))
      (if (i32.eq (local.get $k) (i32.const 2)) (then (local.set $acc (local.get $wind))))
      (f64.store (local.get $b) (local.get $x))
      (f64.store (local.get $a) (f64.add (f64.add (local.get $x) (local.get $v)) (f64.mul (local.get $acc) (f64.mul (local.get $dt) (local.get $dt)))))
      (local.set $k (i32.add (local.get $k) (i32.const 1)))
      (br_if $axes (i32.lt_u (local.get $k) (i32.const 3))))))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $points))))
 (func (export "solve") (param $n i32) (param $p i32) (param $mass i32) (param $edges i32) (param $dt2 f64)
  (local $i i32) (local $e i32) (local $a i32) (local $b i32) (local $ia i32) (local $ib i32)
  (local $dx f64) (local $dy f64) (local $dz f64) (local $d f64) (local $wa f64) (local $wb f64)
  (local $alpha f64) (local $lambda f64) (local $delta f64) (local $ca f64) (local $cb f64)
  (block $done (loop $constraints
   (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
   (local.set $e (i32.add (local.get $edges) (i32.mul (local.get $i) (i32.const 32))))
   (local.set $ia (i32.load (local.get $e))) (local.set $ib (i32.load offset=4 (local.get $e)))
   (local.set $a (i32.add (local.get $p) (i32.mul (local.get $ia) (i32.const 24))))
   (local.set $b (i32.add (local.get $p) (i32.mul (local.get $ib) (i32.const 24))))
   (local.set $wa (f64.load (i32.add (local.get $mass) (i32.mul (local.get $ia) (i32.const 8)))))
   (local.set $wb (f64.load (i32.add (local.get $mass) (i32.mul (local.get $ib) (i32.const 8)))))
   (if (f64.gt (f64.add (local.get $wa) (local.get $wb)) (f64.const 0)) (then
    (local.set $dx (f64.sub (f64.load (local.get $b)) (f64.load (local.get $a))))
    (local.set $dy (f64.sub (f64.load offset=8 (local.get $b)) (f64.load offset=8 (local.get $a))))
    (local.set $dz (f64.sub (f64.load offset=16 (local.get $b)) (f64.load offset=16 (local.get $a))))
    (local.set $d (f64.sqrt (f64.add (f64.add (f64.mul (local.get $dx) (local.get $dx)) (f64.mul (local.get $dy) (local.get $dy))) (f64.mul (local.get $dz) (local.get $dz)))))
    (if (f64.gt (local.get $d) (f64.const 0.0000000001)) (then
     (local.set $alpha (f64.div (f64.load offset=16 (local.get $e)) (local.get $dt2)))
     (local.set $lambda (f64.load offset=24 (local.get $e)))
     (local.set $delta (f64.div (f64.add (f64.sub (local.get $d) (f64.load offset=8 (local.get $e))) (f64.mul (local.get $alpha) (local.get $lambda))) (f64.add (f64.add (local.get $wa) (local.get $wb)) (local.get $alpha))))
     (f64.store offset=24 (local.get $e) (f64.sub (local.get $lambda) (local.get $delta)))
     (local.set $ca (f64.div (f64.mul (local.get $wa) (local.get $delta)) (local.get $d)))
     (local.set $cb (f64.div (f64.mul (local.get $wb) (local.get $delta)) (local.get $d)))
     (f64.store (local.get $a) (f64.add (f64.load (local.get $a)) (f64.mul (local.get $dx) (local.get $ca))))
     (f64.store offset=8 (local.get $a) (f64.add (f64.load offset=8 (local.get $a)) (f64.mul (local.get $dy) (local.get $ca))))
     (f64.store offset=16 (local.get $a) (f64.add (f64.load offset=16 (local.get $a)) (f64.mul (local.get $dz) (local.get $ca))))
     (f64.store (local.get $b) (f64.sub (f64.load (local.get $b)) (f64.mul (local.get $dx) (local.get $cb))))
     (f64.store offset=8 (local.get $b) (f64.sub (f64.load offset=8 (local.get $b)) (f64.mul (local.get $dy) (local.get $cb))))
     (f64.store offset=16 (local.get $b) (f64.sub (f64.load offset=16 (local.get $b)) (f64.mul (local.get $dz) (local.get $cb))))))))
   (local.set $i (i32.add (local.get $i) (i32.const 1))) (br $constraints))))
)
