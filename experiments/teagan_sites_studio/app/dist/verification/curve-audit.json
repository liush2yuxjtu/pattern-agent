{
  "schema": "independent-curve-audit/1",
  "status": "PASS",
  "scopeZh": "Teagan原始母版、配缝优化样例与精确拆分的二维数字曲线复核",
  "methodsZh": [
    "与Teagan 4.10.2原始制版控制点逐项对照",
    "Python幂基形式求值与SciPy自适应积分，独立于应用的Bernstein形式和Gauss积分",
    "按接点切线方向验证G1连续；用导数多项式求根排查曲线内部退化",
    "每条拆分曲线抽查2001个参数点，核对形状不变",
    "从实际SVG路径重新读取坐标，复核量化误差、弧长与接点夹角"
  ],
  "beforeFixZh": "旧优化器只约束弧长，可产生接点折角；旧工程按原算法保留，新检查会标记该问题。",
  "limitsZh": [
    "G1切线连续不代表G2曲率连续；本轮未声明G2要求已通过",
    "反弯检查是每段2001点的采样检查，不是对任意曲线的完备证明",
    "未验证真实面料、人体合身与缝制效果；三维仍为裁片组装预览"
  ],
